# PostgreSQL connection (preferred)
# Either set a full DATABASE_URL or the individual PG_* variables below.
# Example DATABASE_URL: postgres://user:pass@localhost:5432/nuttiness

# Full connection URL (if set this takes precedence)
DATABASE_URL=

# Individual Postgres connection parts (used to assemble DATABASE_URL if not set)
PGHOST=localhost
PGPORT=5432
PGUSER=nuttiness_user
PGPASSWORD=change_me
PGDATABASE=personal_projects
PGSCHEMA=nuttiness

# Optional: SSL mode (disable/require). If your DB uses SSL, set accordingly.
PGSSLMODE=disable

# Optional: pin exact pg_dump/psql binaries for scripts/backup-db.js and
# scripts/restore-db.js. Unset by default — the scripts auto-detect the
# newest Homebrew postgresql@<version> keg (falling back to PATH), which
# avoids "server version mismatch" errors against a newer prod DB (e.g. Neon).
# PG_DUMP_BIN=/opt/homebrew/opt/postgresql@17/bin/pg_dump
# PSQL_BIN=/opt/homebrew/opt/postgresql@17/bin/psql

# Node environment
NODE_ENV=development

# Authentication (shared credentials for all users)
APP_USERNAME=username
APP_PASSWORD=password
SESSION_SECRET=secret_session_key_change_me
